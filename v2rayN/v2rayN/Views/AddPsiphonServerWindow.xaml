<base:WindowBase
    x:Class="v2rayN.Views.AddPsiphonServerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="Psiphon Shirokhorshid Server"
    Width="650"
    Height="520"
    x:TypeArguments="vms:AddPsiphonServerViewModel"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Center"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                Width="100"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True"
                Style="{StaticResource DefButton}" />
            <Button
                x:Name="btnCancel"
                Width="100"
                Margin="{StaticResource MarginLeftRight8}"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="true"
                Style="{StaticResource DefButton}" />
        </StackPanel>
        <ScrollViewer
            materialDesign:ScrollViewerAssist.IsAutoHideEnabled="True"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto">

            <Grid Margin="{StaticResource Margin8}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="{StaticResource Margin8}"
                    FontWeight="SemiBold"
                    Text="Psiphon Tunnel Core (CDN Fronting Edition)" />

                <!-- Remarks -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="{StaticResource Margin8}"
                    VerticalAlignment="Center"
                    Text="{x:Static resx:ResUI.TbRemarks}" />
                <TextBox
                    x:Name="txtRemarks"
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="380"
                    Margin="{StaticResource Margin4}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <!-- Egress Region -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="{StaticResource Margin8}"
                    VerticalAlignment="Center"
                    Text="Egress Region" />
                <ComboBox
                    x:Name="cmbEgressRegion"
                    Grid.Row="2"
                    Grid.Column="1"
                    Width="200"
                    Margin="{StaticResource Margin4}"
                    HorizontalAlignment="Left" />

                <!-- Tunnel Pool Size -->
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="{StaticResource Margin8}"
                    VerticalAlignment="Center"
                    Text="Tunnel Pool Size" />
                <TextBox
                    x:Name="txtPoolSize"
                    Grid.Row="3"
                    Grid.Column="1"
                    Width="100"
                    Margin="{StaticResource Margin4}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <!-- CDN Fronting -->
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="{StaticResource Margin8}"
                    VerticalAlignment="Center"
                    Text="CDN Fronting" />
                <ToggleButton
                    x:Name="togCdnFronting"
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="{StaticResource Margin4}"
                    HorizontalAlignment="Left"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                <!-- Edge IPs / CIDRs / SNI -->
                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="{StaticResource Margin8}"
                    VerticalAlignment="Top"
                    Text="Edge IPs / CIDRs / SNI" />
                <TextBox
                    x:Name="txtCdnEdges"
                    Grid.Row="5"
                    Grid.Column="1"
                    Width="380"
                    Height="80"
                    Margin="{StaticResource Margin4}"
                    AcceptsReturn="True"
                    HorizontalAlignment="Left"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top" />

                <!-- Port -->
                <TextBlock
                    Grid.Row="6"
                    Grid.Column="0"
                    Margin="{StaticResource Margin8}"
                    VerticalAlignment="Center"
                    Text="Local SOCKS Port" />
                <TextBox
                    x:Name="txtPort"
                    Grid.Row="6"
                    Grid.Column="1"
                    Width="160"
                    Margin="{StaticResource Margin4}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />

                <!-- Display Log -->
                <TextBlock
                    Grid.Row="7"
                    Grid.Column="0"
                    Margin="{StaticResource Margin8}"
                    VerticalAlignment="Center"
                    Text="{x:Static resx:ResUI.TbDisplayLog}" />
                <ToggleButton
                    x:Name="togDisplayLog"
                    Grid.Row="7"
                    Grid.Column="1"
                    Margin="{StaticResource Margin4}"
                    HorizontalAlignment="Left"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                <!-- Info note -->
                <TextBlock
                    Grid.Row="8"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="{StaticResource Margin8}"
                    FontStyle="Italic"
                    Opacity="0.6"
                    Text="Psiphon will expose a local SOCKS5/HTTP proxy. CDN Fronting requires the shirokhorshid fork binary." />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</base:WindowBase>
